 io.c           | 34 +++++++++++++++++++++++++++++++++-
 2 files changed, 68 insertions(+), 1 deletion(-)

diff --git a/clientserver.c b/clientserver.c
index b19f81f9..432822c8 100644
--- a/clientserver.c
+++ b/clientserver.c
@@ -82,6 +82,21 @@ struct chmod_mode_struct *daemon_chmod_modes;
