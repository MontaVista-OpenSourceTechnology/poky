+	out = new_array(rsync_acl_ent, ent_list.count ? ent_list.count : 1);
+	if (ent_list.count)
+		memcpy(out, ent_list.items, ent_list.count * sizeof (rsync_acl_ent));
+	*ents_p = out;
+	return ent_list.count;
