  * mode and module_dir is not "/"; otherwise 0.  (Note that a chroot-
  * enabled module can have a non-"/" module_dir these days.) */
@@ -785,6 +800,9 @@ static int rsync_module(int f_in, int f_out, int i, const char *addr, const char
