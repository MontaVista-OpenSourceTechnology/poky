 		 * .cvsignore) sender-controlled: a planted symlink could leak a
@@ -1517,6 +1532,7 @@ void parse_filter_file(filter_rule_list *listp, const char *fname, const filter_
 						"[%s] parse_filter_file(%s) hidden by daemon filter\n",
