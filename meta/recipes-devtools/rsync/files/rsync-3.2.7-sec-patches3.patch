 				for (name = pat + pat_len; name > pat && name[-1] != '/'; name--) {}
 				add_rule(listp, name, (pat + pat_len) - name, excl_self, 0);
@@ -1716,6 +1721,10 @@ void parse_filter_file(filter_rule_list *listp, const char *fname, const filter_
 		merge_depth--;
