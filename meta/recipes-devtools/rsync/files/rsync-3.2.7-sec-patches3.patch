+	strlcpy(src_name, fname, sizeof src_name);
 	dirbuf[dirbuf_len] = '\0';
 
 	/* Rule text from here on is this file's contents, not an argument, so
@@ -1740,7 +1749,6 @@ void parse_filter_file(filter_rule_list *listp, const char *fname, const filter_
 		} else
