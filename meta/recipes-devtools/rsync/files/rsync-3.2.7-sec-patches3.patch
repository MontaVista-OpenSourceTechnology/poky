 zlib/inflate.c  |  77 ++++++++----------------------
 zlib/inftrees.c |  10 ++--
 zlib/trees.c    |  97 ++++++++++---------------------------
 zlib/zutil.c    |  33 ++++---------
 9 files changed, 105 insertions(+), 322 deletions(-)

