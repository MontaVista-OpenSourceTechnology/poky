From f563801437b3b3810c27bd262fd0e5849fb9033b Mon Sep 17 00:00:00 2001
From: Sergey Ponomarev <stokito@gmail.com>
Date: Sun, 24 Dec 2023 18:04:48 +0200
Subject: [PATCH] cli-runopts.c: add PasswordAuthentication option

---
 src/cli-auth.c    | 4 ++--
 src/cli-runopts.c | 9 +++++++++
 src/runopts.h     | 1 +
 3 files changed, 12 insertions(+), 2 deletions(-)

This fixes CVE-2025-47203. Dependency Patch #7.

Signed-off-by: Javier Campos <jcampos@mvista.com>

Index: dropbear-2017.75/cli-auth.c
===================================================================
--- dropbear-2017.75.orig/cli-auth.c
+++ dropbear-2017.75/cli-auth.c
@@ -240,7 +240,7 @@ void recv_msg_userauth_failure() {
 			}
 #endif
 #ifdef ENABLE_CLI_PASSWORD_AUTH
-			if (strncmp(AUTH_METHOD_PASSWORD, tok,
+			if (cli_opts.password_authentication && strncmp(AUTH_METHOD_PASSWORD, tok,
 				AUTH_METHOD_PASSWORD_LEN) == 0) {
 				ses.authstate.authtypes |= AUTH_TYPE_PASSWORD;
 			}
@@ -292,7 +292,7 @@ int cli_auth_try() {
 #endif
 
 #ifdef ENABLE_CLI_PASSWORD_AUTH
-	if (!finished && (ses.authstate.authtypes & AUTH_TYPE_PASSWORD)) {
+	if (!finished && cli_opts.password_authentication && (ses.authstate.authtypes & AUTH_TYPE_PASSWORD)) {
 		if (ses.keys->trans.algo_crypt->cipherdesc == NULL) {
 			fprintf(stderr, "Sorry, I won't let you use password auth unencrypted.\n");
 		} else {
Index: dropbear-2017.75/cli-runopts.c
===================================================================
--- dropbear-2017.75.orig/cli-runopts.c
+++ dropbear-2017.75/cli-runopts.c
@@ -153,6 +153,7 @@ void cli_getopts(int argc, char ** argv)
 	cli_opts.exit_on_fwd_failure = 0;
 #endif
 	cli_opts.disable_trivial_auth = 0;
+	cli_opts.password_authentication = 1;
 #ifdef ENABLE_CLI_LOCALTCPFWD
 	cli_opts.localfwds = list_new();
 	opts.listen_fwd_all = 0;
@@ -890,6 +891,7 @@ static void add_extendedopt(const char*
 			"\tExitOnForwardFailure\n"
 #endif
 			"\tDisableTrivialAuth\n"
+			"\tPasswordAuthentication\n"
 #ifndef DISABLE_SYSLOG
 			"\tUseSyslog\n"
 #endif
@@ -903,6 +905,13 @@ static void add_extendedopt(const char*
 		return;
 	}
 #endif
+
+#ifdef ENABLE_CLI_PASSWORD_AUTH
+	if (match_extendedopt(&optstr, "PasswordAuthentication") == DROPBEAR_SUCCESS) {
+		cli_opts.password_authentication = parse_flag_value(optstr);
+		return;
+	}
+#endif
 
 #ifndef DISABLE_SYSLOG
 	if (match_extendedopt(&optstr, "UseSyslog") == DROPBEAR_SUCCESS) {
Index: dropbear-2017.75/runopts.h
===================================================================
--- dropbear-2017.75.orig/runopts.h
+++ dropbear-2017.75/runopts.h
@@ -146,6 +146,7 @@ typedef struct cli_runopts {
 	int exit_on_fwd_failure;
 #endif
 	int disable_trivial_auth;
+	int password_authentication;
 #ifdef ENABLE_CLI_REMOTETCPFWD
 	m_list * remotefwds;
 #endif
