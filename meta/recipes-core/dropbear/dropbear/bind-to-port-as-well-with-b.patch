--- dropbear-2017.75.orig/svr-tcpfwd.c
+++ dropbear-2017.75/svr-tcpfwd.c
@@ -270,7 +270,7 @@ static int newtcpdirect(struct Channel *
 	}
 
 	snprintf(portstring, sizeof(portstring), "%u", destport);
